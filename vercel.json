{
  "framework": "vite",
  "cleanUrls": true,
  "crons": [
    { "path": "/api/cron/distribution", "schedule": "0 12 * * *" }
  ],
  "headers": [
    {
      "source": "/links",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, follow" }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "radar-docente-pi.vercel.app" }],
      "destination": "https://www.radarpraxia.com/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/api/workshops/:action", "destination": "/api/workshops?action=:action" },
    { "source": "/api/ebook/:action", "destination": "/api/ebook?action=:action" },
    { "source": "/api/admin/certificates", "destination": "/api/certificates?scope=admin" },
    { "source": "/api/certificates/:codigo", "destination": "/api/certificates?codigo=:codigo" },
    { "source": "/api/cms/setup", "destination": "/api/cms/auth?action=setup" },
    { "source": "/rss.xml", "destination": "/api/cms/public?mode=rss" },
    { "source": "/sitemap.xml", "destination": "/api/cms/public?mode=sitemap" },
    { "source": "/blog/avaliacao/como-criar-criterios-de-avaliacao-para-atividades-com-ia", "destination": "/blog/avaliacao/como-criar-criterios-de-avaliacao-para-atividades-com-ia.html" },
    { "source": "/blog/fluencia-digital/o-que-e-fluencia-digital-para-professores", "destination": "/blog/fluencia-digital/o-que-e-fluencia-digital-para-professores.html" },
    { "source": "/blog/planejamento/como-planejar-uma-atividade-pedagogica-com-inteligencia-artificial", "destination": "/blog/planejamento/como-planejar-uma-atividade-pedagogica-com-inteligencia-artificial.html" },
    { "source": "/blog/etica/privacidade-e-dados-no-uso-educacional-de-ferramentas-generativas", "destination": "/blog/etica/privacidade-e-dados-no-uso-educacional-de-ferramentas-generativas.html" },
    { "source": "/blog/ferramentas/como-escolher-uma-ferramenta-de-ia-para-uma-atividade-pedagogica", "destination": "/blog/ferramentas/como-escolher-uma-ferramenta-de-ia-para-uma-atividade-pedagogica.html" },
    { "source": "/blog/avaliacao/como-avaliar-atividades-produzidas-com-apoio-de-ia", "destination": "/blog/avaliacao/como-avaliar-atividades-produzidas-com-apoio-de-ia.html" },
    { "source": "/blog/competencias-docentes/o-que-sao-competencias-docentes-para-uso-de-ia", "destination": "/blog/competencias-docentes/o-que-sao-competencias-docentes-para-uso-de-ia.html" },
    { "source": "/blog/ia-para-professores/usar-ia-com-estudantes-comeca-antes-da-ferramenta", "destination": "/blog/ia-para-professores/usar-ia-com-estudantes-comeca-antes-da-ferramenta.html" },
    { "source": "/blog/planejamento/da-possibilidade-tecnologica-ao-objetivo-de-aprendizagem", "destination": "/blog/planejamento/da-possibilidade-tecnologica-ao-objetivo-de-aprendizagem.html" },
    { "source": "/blog/etica/como-conversar-sobre-autoria-em-atividades-com-ia", "destination": "/blog/etica/como-conversar-sobre-autoria-em-atividades-com-ia.html" },
    { "source": "/blog/categoria/:slug", "destination": "/" },
    { "source": "/blog/:category/:slug", "destination": "/api/cms/public?mode=article-page&category=:category&slug=:slug" },
    { "source": "/sobre", "destination": "/" },
    { "source": "/autores/patrick-naufel", "destination": "/" },
    { "source": "/autores/giovani-letti", "destination": "/" },
    { "source": "/blog", "destination": "/api/cms/public?mode=blog-page" },
    { "source": "/contato", "destination": "/" },
    { "source": "/privacidade", "destination": "/" },
    { "source": "/resultado", "destination": "/" },
    { "source": "/guias", "destination": "/" },
    { "source": "/competencias", "destination": "/" },
    { "source": "/ferramentas", "destination": "/" },
    { "source": "/metodologia", "destination": "/" },
    { "source": "/radar-docente", "destination": "/" },
    { "source": "/para-instituicoes", "destination": "/" },
    { "source": "/ebook", "destination": "/" },
    { "source": "/ebook/obrigado", "destination": "/" },
    { "source": "/mentoria", "destination": "/" },
    { "source": "/radar/:path*", "destination": "/" },
    { "source": "/certificados/:path*", "destination": "/" },
    { "source": "/admin/:path*", "destination": "/" },
    { "source": "/links", "destination": "/" },
    { "source": "/lp/:path*", "destination": "/" },
    { "source": "/:path*", "destination": "/api/not-found" }
  ]
}
